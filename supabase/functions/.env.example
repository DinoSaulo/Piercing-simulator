# Secrets da Edge Function `api`.
#
# Cadastre com:
#   npx supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY NÃO entram aqui: a plataforma injeta
# as duas automaticamente. Nenhum nome abaixo pode começar com `SUPABASE_` — o
# prefixo é reservado e o cadastro é recusado.

# Credenciais do painel /secret/adm.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Assina o cookie de sessão do painel. Gere uma string longa e aleatória:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor invalida todas as sessões abertas.
ADMIN_JWT_SECRET=

# Duração da sessão do painel, em segundos (padrão: 8h).
ADMIN_SESSION_SECONDS=28800

# Lax (padrão) pressupõe o rewrite do vercel.json, que mantém a API na mesma
# origem do site. Só mude para None se o painel for consumir a URL da função
# diretamente — nesse caso ALLOWED_ORIGINS vira obrigatório e o Safari continua
# bloqueando o cookie.
ADMIN_COOKIE_SAMESITE=Lax

# Validade das URLs assinadas das imagens, em segundos (padrão: 1h).
SIGNED_URL_SECONDS=3600

# Quantas simulações a listagem devolve por vez (o contador mostra o total real).
ADMIN_PAGE_SIZE=100

# Bucket privado criado pelo supabase/schema.sql.
STORAGE_BUCKET=simulations

MAX_UPLOAD_BYTES=10485760

# Origens liberadas para chamar a função DIRETO, separadas por vírgula. Deixe
# vazio: o caminho normal é o rewrite do vercel.json, que mantém tudo na mesma
# origem e dispensa CORS.
ALLOWED_ORIGINS=
