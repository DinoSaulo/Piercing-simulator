# Ambiente incompleto, usado por config_missing_test.ts numa invocacao separada
# do `deno test`.
#
# Por que um arquivo separado: config.ts congela os valores no primeiro import,
# entao nao da para simular "secret ausente" mexendo em Deno.env no meio da
# suite — o modulo ja foi avaliado.
#
# SUPABASE_URL e a service role key continuam aqui porque createClient() lanca
# com string vazia: sem elas o proprio import da funcao quebraria, e o teste
# nunca chegaria a verificar a resposta 500. O que falta sao as tres variaveis
# do painel administrativo.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=service-role-de-teste
