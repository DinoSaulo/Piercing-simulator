# Ambiente das suites automatizadas. Valores falsos de proposito: nenhuma
# requisicao sai da maquina — support/fetch_fake.ts intercepta o fetch antes de
# supabase.ts criar o client.
#
# Versionado (o .gitignore abre excecao para este arquivo) porque sem ele os
# testes nao rodam: config.ts le tudo no import, entao a env precisa existir
# antes do primeiro import da funcao.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=service-role-de-teste

STORAGE_BUCKET=simulations-test

# 1 MB. Menor que o default de 10 MB para os testes de limite nao precisarem
# alocar buffers grandes.
MAX_UPLOAD_BYTES=1048576

ALLOWED_ORIGINS=https://piercing.exemplo.test,https://outra.exemplo.test

ADMIN_USERNAME=admin-de-teste
ADMIN_PASSWORD=senha-de-teste
ADMIN_JWT_SECRET=segredo-jwt-de-teste-com-tamanho-suficiente
ADMIN_SESSION_SECONDS=3600

SIGNED_URL_SECONDS=600
ADMIN_PAGE_SIZE=5
