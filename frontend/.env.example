# Para onde o dev server do Vite encaminha as chamadas /api.
#
# Padrão: a Edge Function servida localmente por `npx supabase functions serve`.
# Para apontar para o projeto publicado, use a URL do Supabase:
#   VITE_API_PROXY_TARGET=https://<ref>.supabase.co
#
# Em produção este valor não é usado: quem encaminha é o rewrite do vercel.json.
VITE_API_PROXY_TARGET=http://127.0.0.1:54321
