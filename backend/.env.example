# URL do projeto Supabase (Project Settings > Data API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave secreta (Project Settings > API Keys), no formato sb_secret_...
# Ela ignora RLS: mantenha apenas no servidor e nunca comite o .env preenchido.
# Projetos antigos podem usar SUPABASE_SERVICE_ROLE_KEY no lugar.
SUPABASE_SECRET_KEY=

# Bucket privado criado pelo supabase/schema.sql
SUPABASE_STORAGE_BUCKET=simulations

PORT=3333
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
