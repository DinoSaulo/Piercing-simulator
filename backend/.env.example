# URL do projeto Supabase (Project Settings > Data API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave service_role (Project Settings > API Keys).
# NUNCA coloque essa chave no frontend nem comite o .env preenchido.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket privado criado pelo supabase/schema.sql
SUPABASE_STORAGE_BUCKET=simulations

PORT=3333
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
